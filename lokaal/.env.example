# Kopieer dit bestand naar .env en vul je eigen sleutels in.
# .env staat in .gitignore en komt dus nooit in de repo of op GitHub.

# Company.info - de technisch contactpersoon uit de onboarding heeft deze per mail gekregen
COMPANYINFO_API_KEY=
COMPANYINFO_BASE=https://api.company.info
COMPANYINFO_HEADER=X-API-Key

# Lusha - maak een NIEUWE sleutel aan; een sleutel die ergens in een chat of
# document heeft gestaan moet je als gelekt beschouwen en intrekken.
LUSHA_API_KEY=
LUSHA_BASE=https://api.lusha.com
# Controleer de headernaam in de Lusha-documentatie als je 401 krijgt.
LUSHA_HEADER=api_key

# Optioneel
PORT=4321
TIMEOUT_MS=20000
